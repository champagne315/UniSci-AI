# 对话模型
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Agent 工具调用（模型必须支持 OpenAI Chat Completions 的 tools/tool_calls 协议）
# 单回合最大工具执行次数；用于防止工具循环
MAX_TOOL_STEPS=6
# 可选：SearXNG 或兼容 JSON 搜索端点，例如 https://search.example.com/search
# 未配置时使用公开 DuckDuckGo HTML 搜索适配器
WEB_SEARCH_ENDPOINT=
# 可选：覆盖 Agent 隔离工作区根目录
# AGENT_WORKSPACE_DIR=

# 方舟 Agent Plan 专属向量模型
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OPENAI_EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_BATCH_SIZE=1
RAG_SEMANTIC_WEIGHT=0.75

# 图片与扫描版 PDF 的 OCR（可选；未配置时仍支持带文字层的 PDF）
GLM_OCR_API_KEY=
GLM_OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4/layout_parsing
GLM_OCR_MODEL=glm-ocr
GLM_OCR_TIMEOUT_MS=60000
